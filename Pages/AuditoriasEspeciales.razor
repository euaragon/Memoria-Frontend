@page "/auditorias-especiales"
@inject HttpClient Http
@inject IConfiguration Configuration

<PageTitle>Auditorías Especiales</PageTitle>

<h1>Auditorías Especiales</h1>


<table class="table table-hover mt-5 tabla-aud-esp">
    <thead class="table-group-divider">
        <tr>
            <th class="bg-transparent">Organismo Auditado</th>
            <th class="bg-transparent">Tema</th>
        </tr>
    </thead>
    <tbody>
        @if (auditorias != null)
        {
            @foreach (var auditoria in auditorias)
            {
                <tr>
                    <td class="bg-transparent">@auditoria.OrganismoAuditado</td>
                    <td class="bg-transparent">@auditoria.Tema</td>
                </tr>
            }
        }
    </tbody>
</table>

<NavLink type="button" class="text-black mt-md-5" href="/Memoria/2024/"> <img class="me-2" width="32" height="32"
        src="https://img.icons8.com/windows/32/000000/return.png" alt="return" />
    VOLVER</NavLink>



@code {
    private audExt[]? auditorias;
    private string? baseUrl;
    protected override async Task OnInitializedAsync()
    {
        baseUrl = Configuration["ApiBaseUrl"];
        auditorias = await Http.GetFromJsonAsync<audExt[]>($"{baseUrl}audExt");
        Console.WriteLine(auditorias);
    }

    public class audExt
    {
        public string? OrganismoAuditado { get; set; }
        public string? Tema { get; set; }
    }
}
