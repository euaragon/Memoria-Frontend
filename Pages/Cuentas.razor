@page "/cuentas"
@inject IJSRuntime JS
@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject IConfiguration Configuration
@using System.Text.Json;

<PageTitle>Cuentas Falladas en 2024</PageTitle>

<h1 class="text-center mb-4">@tituloFallos</h1>
<p>
    Un Fallo es una resolución que aprueba o no las rendiciones de los Organismos a cargo de fondos públicos...
</p>

<div class="mt-5 p-3" style="width: 100%; overflow-x: auto;">
    <div style="min-width: 600px; height: 600px;">
        <canvas id="cuadro-fallos-cuentas"></canvas>
    </div>
</div>

<div class="overflow-auto mb-5">
    <table class="table table-sm table-responsive table-hover mt-5 tabla-aud-esp text-uppercase">
        <thead class="table-group-divider">
            <tr>
                <th class="bg-transparent">Año</th>
                <th class="bg-transparent">Fallo</th>
                <th class="bg-transparent">Organismo</th>
                <th class="bg-transparent">Área</th>
                <th class="bg-transparent">Fecha</th>
                <th class="bg-transparent">Expte</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var cuenta in GetCurrentPageData())
            {
                <tr>
                    <td class="bg-transparent">@cuenta.Anio</td>
                    <td class="bg-transparent">
                        <a class="btn btn-primary text-light" href="javascript:void(0)"
                           @onclick="() => VerDetalleDesdeBusqueda(cuenta.Resultado)">
                            @cuenta.Nro
                        </a>
                    </td>
                    <td class="bg-transparent">@cuenta.Organismo</td>
                    <td class="bg-transparent">@cuenta.Area</td>
                    <td class="bg-transparent">@cuenta.Fecha</td>
                    <td class="bg-transparent">@cuenta.Expediente</td>
                </tr>
            }
        </tbody>
    </table>

    <div class="d-flex justify-content-center mt-5 align-items-center gap-4">
        <button class="btn btn-primary me-2" @onclick="PreviousPage" disabled="@(currentPage == 1)">Anterior</button>
        <span>Página @currentPage de @totalPages</span>
        <button class="btn btn-primary ms-2" @onclick="NextPage"
                disabled="@(currentPage == totalPages)">Siguiente</button>
    </div>
</div>

<BSModal @ref="modalDetalle" Title="Detalle del Fallo" Size="Size.ExtraLarge">
    @if (falloSeleccionado != null)
    {
        <div class="p-5">
            <Header>
                <h1 class="mb-4">Fallo Nº @falloSeleccionado.FalNumero</h1>
            </Header>

            <Content>
                <div class="mb-3">
                    <h6 class="text-muted">Organismo</h6>
                    <p class="mb-1">@falloSeleccionado.EntRazonSocial</p>
                </div>

                <div class="mb-3">
                    <h6 class="text-muted">Destinado a</h6>
                    <p class="mb-1">@falloSeleccionado.AplDigNombre</p>
                </div>

                <div class="mb-3">
                    <h6 class="text-muted">Extracto</h6>
                    <p class="mb-1">@falloSeleccionado.DigExtracto</p>
                </div>

                <hr />

                <div class="row">
                    <div class="col-md-4">
                        <h6 class="text-muted">Fecha de Emisión</h6>
                        <p>@falloSeleccionado.DigFEmision?.ToString("dd/MM/yyyy")</p>
                    </div>
                    <div class="col-md-4">
                        <h6 class="text-muted">Fecha de Publicación</h6>
                        <p>@falloSeleccionado.DigFPublicacion?.ToString("dd/MM/yyyy")</p>
                    </div>
                    <div class="col-md-4">
                        <h6 class="text-muted">Fecha de Vigencia</h6>
                        <p>@falloSeleccionado.DigFVigencia?.ToString("dd/MM/yyyy")</p>
                    </div>
                </div>
                <button class="btn btn-outline-primary" @onclick="DescargarPdf">
                    Descargar PDF del Fallo
                </button>
            </Content>
        </div>
    }
</BSModal>

<NavLink type="button" class="text-black mt-md-5" href="https://www.tribcuentasmendoza.gob.ar/Memoria/2024/">
    <img class="me-2" width="32" height="32" src="https://img.icons8.com/windows/32/000000/return.png" alt="return" />
    VOLVER
</NavLink>

@code {

    private List<ResultadoDigesto> cabeceraFallos = new();
    private List<ResultadoDigesto> gastosReservadosFallos = new();
    private List<ResultadoDigesto> piezaSeparadaFallos = new();

    private BSModal? modalDetalle;
    private ResultadoDigesto? falloSeleccionado;
    private List<Fallo> cuentas = new(); // Cambiado a List<Fallo> para almacenar todos los resultados
    private int currentPage = 1;
    private int pageSize = 15;
    private int totalPages;
    private string? tituloFallos;
    private string? fallosApiBaseUrl;
    private List<ResultadoDigesto> resultadosCompletos = new(); // Para almacenar todos los resultados sin procesar

    protected override async Task OnInitializedAsync()
    {
        fallosApiBaseUrl = Configuration["ApiConfiguration:BaseUrl"];
        var opciones = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };

        try
        {
            // Cargar datos de cabecera
            var urlCabecera = $"{fallosApiBaseUrl}/api/Fallos/fallos2024/todos";
            var responseCabecera = await Http.GetAsync(urlCabecera);
            if (responseCabecera.IsSuccessStatusCode)
            {
                var content = await responseCabecera.Content.ReadAsStringAsync();
                var resultado = JsonSerializer.Deserialize<List<ResultadoDigesto>>(content, opciones);
                if (resultado != null)
                {
                    cabeceraFallos = resultado;
                    resultadosCompletos.AddRange(resultado);
                }
            }

            

            // Procesar y ordenar todos los resultados
            cuentas = resultadosCompletos
                .Select(d => new Fallo
                {
                    Nro = d.FalNumero ?? 0,
                    Organismo = d.EntRazonSocial,
                    Fecha = d.FalFechaEmision?.ToString("dd/MM/yyyy") ?? "-",
                    Expediente = d.ExpNumero,
                    Area = d.SecNombre,
                    Anio = d.ExpEjercicio ?? 0,
                    DigId = d.DigId,
                    Resultado = d
                })
                .OrderBy(f => f.Nro)
                .ToList();

            totalPages = (int)Math.Ceiling(cuentas.Count / (double)pageSize);
            tituloFallos = $"{cuentas.Count} Cuentas Falladas en 2024";
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error cargando fallos: {ex.Message}");
        }
    }

    private List<Fallo> GetCurrentPageData()
    {
        int startIndex = (currentPage - 1) * pageSize;
        return cuentas.Skip(startIndex).Take(pageSize).ToList();
    }

    private void PreviousPage() => currentPage = Math.Max(1, currentPage - 1);
    private void NextPage() => currentPage = Math.Min(totalPages, currentPage + 1);

    private async Task VerDetalleDesdeBusqueda(ResultadoDigesto? fallo)
    {
        if (fallo is null) return;
        falloSeleccionado = fallo;
        await modalDetalle?.ShowAsync();
    }

    private async Task DescargarPdf()
    {
        if (falloSeleccionado is null) return;
        try
        {
            var pdfUrl = $"{fallosApiBaseUrl}/api/fallos/pdf/{falloSeleccionado.DigId}";
            await JS.InvokeVoidAsync("abrirPdf", pdfUrl);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al descargar PDF: {ex.Message}");
        }
    }

    private async Task CuadroFallos()
    {
        try
        {
            await JS.InvokeVoidAsync("cuadroFallosCuentas");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error en JS: {ex.Message}");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await CuadroFallos();
        }
    }

    public class FiltroBusqueda
    {
        public string Numero { get; set; } = string.Empty;
        public string OrgAplicacion { get; set; } = string.Empty;
        public string PalabraClave { get; set; } = string.Empty;
    }

    public class ResultadoDigesto
    {
        public int DigId { get; set; }
        public string? DigNumero { get; set; }
        public string? EntRazonSocial { get; set; }
        public DateTime? DigFEmision { get; set; }
        public DateTime? DigFPublicacion { get; set; }
        public DateTime? DigFVigencia { get; set; }
        public string? DigExtracto { get; set; }
        public string? AplDigNombre { get; set; }

        public int? FalNumero { get; set; }
        public DateTime? FalFechaEmision { get; set; }
        public string? ExpNumero { get; set; }
        public int? ExpEjercicio { get; set; }

        public string? SecNombre { get; set; } // <-- ESTE ES EL CAMPO DE ÁREA
    }
    public class Fallo
    {
        public string? Expediente { get; set; }
        public int? Anio { get; set; }
        public string? Organismo { get; set; }
        public int? Nro { get; set; }
        public string? Fecha { get; set; }
        public string? Area { get; set; }

        public int DigId { get; set; }
        public ResultadoDigesto? Resultado { get; set; }
    }
}